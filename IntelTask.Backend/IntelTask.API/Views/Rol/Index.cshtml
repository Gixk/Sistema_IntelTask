@model IEnumerable<IntelTask.Domain.Entities.Rol>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CT_Nombre_rol)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CN_Jerarquia)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CT_Nombre_rol)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CN_Jerarquia)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CN_Id_rol">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CN_Id_rol">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CN_Id_rol">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
